# Backend-only secrets (copy to Backend/.env).
# PORT / CORS_ORIGINS live in the project root .env.
# The frontend API URL lives in Frontend/Pages/JS/api.js.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-string

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

SMTP_EMAIL=<gmail-address>
SMTP_APP_PASS=<gmail-app-password>
NODE_ENV=<envoirnment>
