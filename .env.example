# ============================================================
# Backend / shared environment configuration (copy to .env)
# ============================================================
# The frontend API URL lives in Frontend/Pages/JS/api.js (single place).

# Backend port
PORT=4000

# Frontend origins allowed to call the API with credentials (comma separated).
# Add your deployed frontend origin in production, e.g. https://sasta-leja.vercel.app
CORS_ORIGINS=http://localhost:4000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
